# Скопируй в autoeval/.env и заполни.
# OpenRouter — единый ключ для всех моделей (Claude/GPT/Gemini).
OPENROUTER_API_KEY=

# Модель для прогона промпта кандидата на скрытом тест-сете.
# Дешёвая и быстрая — Haiku/4o-mini хватит, кандидаты часто такие и используют.
PROMPTFOO_TARGET_MODEL=openrouter:anthropic/claude-haiku-4-5

# Модель для LLM-судьи и llm-rubric (тон, факты, осмысленность лога).
# Должна быть сильнее target — иначе судья хуже выпускника.
PROMPTFOO_JUDGE_MODEL=openrouter:anthropic/claude-sonnet-4-6
